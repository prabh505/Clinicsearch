# ClinicSearch configuration
# Copy this file to .env and edit values as needed

# ---- Ollama configuration ----
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
EMBED_MODEL=embeddinggemma:300m-qat-q8_0

# ---- ChromaDB configuration ----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=clinicsearch_v1

# ---- Whisper configuration ----
# Options: tiny, base, small (small recommended for Swahili/Hindi accuracy)
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# ---- RAG configuration ----
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50
TOP_K_RETRIEVAL=5
MAX_ANSWER_TOKENS=400

# ---- Streamlit configuration ----
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
